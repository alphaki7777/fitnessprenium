        </div>
        
        <div className="grid grid-cols-2 gap-3">
          {[1, 2, 3, 4, 5, 6].map(i => (
            <div key={i} className="relative aspect-[3/4] bg-slate-800 rounded-xl overflow-hidden group cursor-pointer">
              <div className="absolute inset-0 bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
                <Camera className="text-slate-600" size={48} />
              </div>
              <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-3 opacity-0 group-hover:opacity-100 transition">
                <div className="text-white text-sm font-semibold">Semaine {i}</div>
                <div className="text-slate-300 text-xs">{new Date(Date.now() - i * 7 * 24 * 60 * 60 * 1000).toLocaleDateString()}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="mb-6">
        <h3 className="text-lg font-bold text-white mb-4">Statistiques de transformation</h3>
        <div className="bg-slate-800 rounded-xl p-4 space-y-3">
          <div className="flex justify-between items-center">
            <span className="text-slate-400">Poids</span>
            <div className="text-right">
              <div className="text-white font-bold">82kg</div>
              <div className="text-green-400 text-xs">-3kg depuis le début</div>
            </div>
          </div>
          <div className="flex justify-between items-center">
            <span className="text-slate-400">Tour de taille</span>
            <div className="text-right">
              <div className="text-white font-bold">88cm</div>
              <div className="text-green-400 text-xs">-5cm</div>
            </div>
          </div>
          <div className="flex justify-between items-center">
            <span className="text-slate-400">Tour de bras</span>
            <div className="text-right">
              <div className="text-white font-bold">38cm</div>
              <div className="text-green-400 text-xs">+2cm</div>
            </div>
          </div>
        </div>
      </div>

      <button className="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-4 rounded-xl transition flex items-center justify-center gap-2">
        <Camera size={24} />
        Ajouter une photo
      </button>
    </div>
  );

  // Navigation en bas
  const BottomNav = () => (
    <div className="bg-slate-800 border-t border-slate-700 flex justify-around py-3">
      <button
        onClick={() => setCurrentPage('home')}
        className={`flex flex-col items-center gap-1 ${currentPage === 'home' ? 'text-blue-500' : 'text-slate-400'}`}
      >
        <Home size={24} />
        <span className="text-xs">Accueil</span>
      </button>
      <button
        onClick={() => setCurrentPage('progress')}
        className={`flex flex-col items-center gap-1 ${currentPage === 'progress' ? 'text-blue-500' : 'text-slate-400'}`}
      >
        <TrendingUp size={24} />
        <span className="text-xs">Progrès</span>
      </button>
      <button
        onClick={() => setCurrentPage('community')}
        className={`flex flex-col items-center gap-1 ${currentPage === 'community' ? 'text-blue-500' : 'text-slate-400'}`}
      >
        <Users size={24} />
        <span className="text-xs">Communauté</span>
      </button>
      <button
        onClick={() => setCurrentPage('nutrition')}
        className={`flex flex-col items-center gap-1 ${currentPage === 'nutrition' ? 'text-blue-500' : 'text-slate-400'}`}
      >
        <Apple size={24} />
        <span className="text-xs">Nutrition</span>
      </button>
      <button
        onClick={() => setCurrentPage('photos')}
        className={`flex flex-col items-center gap-1 ${currentPage === 'photos' ? 'text-blue-500' : 'text-slate-400'}`}
      >
        <Camera size={24} />
        <span className="text-xs">Photos</span>
      </button>
    </div>
  );

  const getPageTitle = () => {
    const titles = {
      home: 'GymTracker Pro',
      progress: 'Progression',
      community: 'Communauté',
      nutrition: 'Nutrition',
      photos: 'Galerie'
    };
    return titles[currentPage] || 'GymTracker Pro';
  };

  return (
    <div className="h-screen flex flex-col bg-slate-900 max-w-md mx-auto">
      {!showCreateSession && <Header title={getPageTitle()} />}
      
      {showCreateSession ? (
        <CreateSessionPage />
      ) : (
        <>
          {currentPage === 'home' && <HomePage />}
          {currentPage === 'progress' && <ProgressPage />}
          {currentPage === 'community' && <CommunityPage />}
          {currentPage === 'nutrition' && <NutritionPage />}
          {currentPage === 'photos' && <PhotosPage />}
        </>
      )}
      
      {!showCreateSession && <BottomNav />}
    </div>
  );
};

export default App;
